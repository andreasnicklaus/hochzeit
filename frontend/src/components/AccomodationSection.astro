---

<section class="py-24 px-6 bg-paper" id="unterkuenfte">
  <div class="max-w-2xl mx-auto text-center" data-animate="fade-up">
    <p class="text-sm uppercase tracking-[0.3em] text-stone-400 mb-6 font-body font-light">
      Übernachten
    </p>
    <h2 class="font-display text-3xl md:text-4xl font-semibold text-stone-800">
      Unterkünfte
    </h2>
    <p class="text-stone-500 font-body font-light mt-4 text-sm leading-relaxed">
      Für Gäste, die von weiter anreisen, haben wir ein paar Empfehlungen in der Nähe von Schloss Filseck.
    </p>
  </div>

  <div class="max-w-3xl mx-auto mt-12 grid gap-4 sm:grid-cols-2" data-animate="fade-up">
    {
      accommodations.map((a) => (
        <div class="rounded-xl border border-beige bg-white p-6 flex flex-col">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-display text-lg font-semibold text-stone-800">{a.name}</h3>
            <span
              class="shrink-0 text-sm text-terracotta bg-terracotta/10 rounded-full px-2.5 py-1"
              title={a.priceTitle}
            >
              {a.price}
            </span>
          </div>
          <p class="mt-1 text-xs text-stone-400 font-body font-light">{a.address}</p>

          <div class="mt-5 space-y-2 text-sm text-stone-500 font-body font-light">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-sage shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              <span>{a.distance}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-sage shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{a.drive}</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-beige flex flex-wrap items-center gap-x-5 gap-y-2">
            <a
              href={a.website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-terracotta hover:text-terracotta/70 transition-colors font-body font-light"
            >
              Zur Hotelwebseite &rarr;
            </a>
            <a
              href={a.maps}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-terracotta hover:text-terracotta/70 transition-colors font-body font-light"
            >
              In Google Maps &ouml;ffnen &rarr;
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>